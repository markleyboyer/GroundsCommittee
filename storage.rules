rules_version = '2';

// Files: minutes are readable by every member; receipts only by the uploader, the treasurer and the admin.
// Membership comes from the login's custom claims {member, role, treasurer}, which Cloud Functions copy
// from members/{uid} (see syncClaims in functions/index.js). The guest demo (role "demo") can't open files.
service firebase.storage {
  match /b/{bucket}/o {
    function isMember() {
      return request.auth != null && request.auth.token.get('member', false) == true
        && request.auth.token.get('role', '') != 'demo';
    }
    function isAdmin() { return isMember() && request.auth.token.role == 'admin'; }
    function isTreasurer() { return isMember() && (request.auth.token.role == 'admin' || request.auth.token.get('treasurer', false) == true); }
    function uploadOk(maxMb) {
      return isMember() && request.resource.size < maxMb * 1024 * 1024
        && request.resource.metadata.uploadedBy == request.auth.uid;
    }

    match /minutes/{id}/{file} {
      allow read: if isMember();
      allow create: if uploadOk(30);
      allow delete: if isAdmin() || (isMember() && resource.metadata.uploadedBy == request.auth.uid);
    }

    match /receipts/{uid}/{file} {
      allow read: if (isMember() && request.auth.uid == uid) || isTreasurer();
      allow create: if request.auth.uid == uid && uploadOk(20);
      allow delete: if isAdmin() || (isMember() && request.auth.uid == uid);
    }
  }
}
